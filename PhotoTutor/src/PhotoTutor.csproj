<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x86</PlatformTarget>
    <AssemblyName>拍照解题助教</AssemblyName>
    <RootNamespace>PhotoTutor</RootNamespace>
    <Version>1.6.4</Version>
    <Title>深度求索</Title>
    <Product>深度求索</Product>
    <Description>深度求索 · 拍照解题与课堂讲解</Description>
    <WindowsMetadataPath Condition="'$(WindowsMetadataPath)'==''">$(MSBuildProgramFiles32)\Windows Kits\10\UnionMetadata\10.0.22621.0\Windows.winmd</WindowsMetadataPath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>PhotoTutor.Entry</StartupObject>
  </PropertyGroup>
  <ItemGroup>

    <Compile Remove="MainWindow.cs;LessonView.cs;ScreenPick.cs" />
    <Content Include="..\CloudUpdates\bin\Release\net48\课堂助教更新.exe" Link="课堂助教更新.exe" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="Windows"><HintPath>$(WindowsMetadataPath)</HintPath><IsWinMDFile>true</IsWinMDFile><Private>false</Private></Reference>
    <Reference Include="System.Runtime.WindowsRuntime"><HintPath>$(windir)\Microsoft.NET\Framework\v4.0.30319\System.Runtime.WindowsRuntime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Runtime" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Security" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="DirectShowLib.Standard" Version="2.1.0" />
    <PackageReference Include="WpfMath" Version="2.1.0" />
  </ItemGroup>
  <ItemGroup Condition="Exists('../LocalOcr/runtime.zip')">
    <EmbeddedResource Include="../LocalOcr/runtime.zip" LogicalName="PhotoTutor.LocalOcr.zip" />
    <EmbeddedResource Include="../LocalOcr/runtime-manifest.json" LogicalName="PhotoTutor.LocalOcr.manifest.json" />
  </ItemGroup>
</Project>
